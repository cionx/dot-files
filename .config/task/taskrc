# [Created by task 3.4.1 8/20/2025 20:36:15]
data.location=~/.local/share/task
hooks.location=~/.config/task/hooks
news.version=3.4.1

# Color theme (uncomment one to use)
#include light-16.theme
#include light-256.theme
#include bubblegum-256.theme
#include dark-16.theme
#include dark-256.theme
#include dark-red-256.theme
#include dark-green-256.theme
#include dark-blue-256.theme
include dark-violets-256.theme
#include dark-yellow-green.theme
#include dark-gray-256.theme
#include dark-gray-blue-256.theme
#include solarized-dark-256.theme
#include solarized-light-256.theme
#include no-color.theme
report.next.columns=id,description,priority,tags,scheduled.countdown,due.relative,until.remaining
report.next.labels=ID,Description,P,Tag,S,Due,Until
report.next.filter=status:pending -WAITING -BLOCKED limit:page

# Make search case insensitive.
search.case.sensitive=0

# Use all tags for autocompletion, even from old tasks.
complete.all.tags=1

# Don’t auto-propagate changes to siblings.
# Sadly this also disables auto-propagation to children, which is slightly annoying.
recurrence.confirmation=0

# Weeks start on Mondays.
weekstart=Monday
